# AegisLang Environment Variables
# Copy this file to .env and fill in your values
#
# Only variables actually read by code are listed here.
# Defaults shown in comments match the code defaults.

# -----------------------------------------------------------------------------
# LLM API Keys (at least one required for real clause extraction)
# Without these, the pipeline uses mock/regex-based parsing.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# API Authentication
# -----------------------------------------------------------------------------
# Comma-separated list of valid API keys for X-API-Key header.
# If unset and AEGISLANG_DISABLE_AUTH is not true, a random dev key is
# generated and logged at startup.
AEGISLANG_API_KEYS=your-api-key-1,your-api-key-2
# Set to "true" to disable API key authentication (development only)
# AEGISLANG_DISABLE_AUTH=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# AEGISLANG_RATE_LIMIT_MINUTE=60
# AEGISLANG_RATE_LIMIT_HOUR=1000

# -----------------------------------------------------------------------------
# Storage Backend
# -----------------------------------------------------------------------------
# "memory" (default) or "sqlite". Memory storage is ephemeral and requires
# workers=1. SQLite is persistent and supports multiple workers.
# AEGISLANG_STORAGE_BACKEND=memory
# Path to SQLite database file (only used when backend=sqlite)
# AEGISLANG_SQLITE_PATH=aegislang_data.db

# -----------------------------------------------------------------------------
# Job Management
# -----------------------------------------------------------------------------
# TTL for completed/failed jobs in seconds (default: 86400 = 24 hours)
# AEGISLANG_JOB_TTL_SECONDS=86400
# Maximum upload file size in bytes (default: 52428800 = 50MB)
# AEGISLANG_MAX_FILE_SIZE=52428800

# -----------------------------------------------------------------------------
# Graph Database (optional — for provenance tracking)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
# Environment name: development, staging, production
# Controls error message verbosity (production hides internal details)
# AEGISLANG_ENV=development
# Log level override: DEBUG, INFO, WARNING, ERROR, CRITICAL
# AEGISLANG_LOG_LEVEL=INFO
# Optional log file path (in addition to stdout)
# AEGISLANG_LOG_FILE=
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=
# Version string reported to Sentry
# AEGISLANG_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8080
# WORKERS=4
# RELOAD=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins
# CORS_ORIGINS=http://localhost:3000
